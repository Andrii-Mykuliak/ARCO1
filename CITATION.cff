    orcid: "https://orcid.org/0000-0003-0133-8591"
    affiliation: >-
      Department of Artificial Intelligence, Lviv Polytechnic National University
license: MIT
keywords:
  - thematic taxonomy
  - sentence embeddings
  - HDBSCAN
  - cluster validation
  - data-to-text
  - sports commentary
  - reproducibility
